# schema=app keeps these tables apart from the RAG data in the same database
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag?schema=app
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Vite dev server; requests are proxied so cookies stay same-origin
WEB_ORIGIN=http://localhost:5173
RAG_URL=http://localhost:8000
# Must equal INTERNAL_TOKEN in rag/.env (openssl rand -hex 32)
RAG_INTERNAL_TOKEN=
# Any S3-compatible service. R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rag
