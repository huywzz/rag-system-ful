ALIBABA_API_KEY=
# Mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-flash
# Changing the embedding model requires a new QDRANT_COLLECTION (different vector size).
EMBEDDING_MODEL=qwen3.7-text-embedding
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents_qwen
USER_AGENT=rag-system
# Must equal RAG_INTERNAL_TOKEN in backend/.env
INTERNAL_TOKEN=
# Raw file storage (read-only here), any S3-compatible service. R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rag
